{
  "name": "ugarit-vite-plugin",
  "version": "1.00.00",
  "description": "Ugarit plugin for Vite.",
  "keywords": [
    "ugarit",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/ugaritco/vite-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/ugaritco/vite-plugin"
  },
  "license": "MIT",
  "author": "Muath R Abu Ouda <muathrabuouda@hotmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./inertia-helpers": {
      "types": "./inertia-helpers/index.d.ts",
      "default": "./inertia-helpers/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts/index.d.ts",
      "default": "./dist/fonts/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "/dist",
    "/inertia-helpers"
  ],
  "bin": {
    "clean-orphaned-assets": "bin/clean.js"
  },
  "scripts": {
    "build": "node build.js",
    "lint": "eslint --ext .ts ./src ./tests",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@types/node": "^20.19.0 || >=22.12.0",
    "@types/picomatch": "^4.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "0.28.1",
    "eslint": "^9.0.0",
    "globals": "^16.3.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.5",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "fontaine": "^0.8.0"
  },
  "peerDependenciesMeta": {
    "fontaine": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "picocolors": "^1.0.0",
    "tinyglobby": "^0.2.12",
    "vite-plugin-full-reload": "^1.1.0"
  }
}
